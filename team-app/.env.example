# Copy to .env and fill in. NEVER commit real keys (see D7 / intro slide 23).
# The AI-use log and run_settings must never record secrets.

# LLM provider
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL="https://api.deepseek.com"
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# TradingAgents config overrides (env-var → config-key map in default_config.py)
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-flash
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash

# Live tests / phases
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1